{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConvoyRun",
  "version": "0.3.4",
  "identifier": "com.convoyrama.convoyrun",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ConvoyRun — CONVOYRAMA",
        "width": 1320,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 700,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://catbox.moe https://litterbox.catbox.moe https://convoyrama.github.io https://github.com"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
